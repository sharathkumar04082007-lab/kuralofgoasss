# Environment Mode (development / production)
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Speech-to-Text Provider (sarvam, elevenlabs, or mock)
STT_PROVIDER=mock
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
STT_LANGUAGE_CODE=hi-IN
STT_TIMEOUT_SECONDS=5.0

# Generation / LLM Configuration (local, groq, gemini, or mock)
LLM_PROVIDER=local
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=150

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_SIZE=10000

# Vector Database (Qdrant)
QDRANT_MODE=embedded
QDRANT_PATH=./data/qdrant_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=msmarco_xi_collection

# Retrieval Settings
TOP_K=5
RERANK_TOP_K=15
MIN_RETRIEVAL_SCORE=0.30
HYBRID_SEARCH=true
USE_RERANKER=false

# Chunking Configuration (sentence, semantic, metadata, or fixed)
DEFAULT_CHUNKING_STRATEGY=sentence
CHUNK_SIZE=250
CHUNK_OVERLAP=30

# Guardrails and Grounding Thresholds
ENABLE_SAFETY_GUARDRAILS=true
ENABLE_PROMPT_INJECTION_DEFENSE=true
GROUNDING_THRESHOLD=0.35
MAX_QUERY_LENGTH=300
